# Copy to .env for local builds (never commit .env). On Vercel, set these in
# Project Settings -> Environment Variables instead.

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> the "publishable" key
# (sb_publishable_...) or, on older projects, the legacy "anon" key.
# It is safe in the browser: Row Level Security protects the data.
# NEVER use the secret / service_role key here (the build refuses it).
SUPABASE_ANON_KEY=your-anon-public-key
